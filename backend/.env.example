# Copy to .env and fill in real values. Never commit .env.
# Everything here is optional: without it the app still runs end to end.

# AI features (AWS Bedrock): matching a free-text treatment description to a
# procedure, and plain-English insurance term explanations. Without these,
# the app uses keyword matching and the built-in term definitions.
BEDROCK_MODEL_ID=
AWS_REGION=us-east-2
# AWS credentials, unless you use an AWS profile or `aws configure`:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
